{
  "name": "pi-extensible-workflows-workspace",
  "version": "3.4.2",
  "private": true,
  "description": "Workspace orchestrator for pi-extensible-workflows",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/extensions/*"
  ],
  "pi": {
    "extensions": ["./packages/core/src/index.ts"]
  },
  "scripts": {
    "build": "npm run build --workspace=packages/core",
    "inspect": "npm run inspect --workspace=packages/core",
    "lint": "eslint .",
    "test": "npm run test --workspace=packages/core && npm run test:template",
    "test:run": "npm run test:run --workspace=packages/core",
    "test:template": "node --test packages/core/examples/workflow-extension-template/extension.test.mjs",
    "acceptance": "npm run acceptance --workspace=packages/core",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run lint && npm test && npm run docs:check",
    "evals": "npm run evals --workspace=packages/core",
    "evals:ambient": "npm run evals:ambient --workspace=packages/core",
    "pack:core": "npm pack --workspace=packages/core --dry-run",
    "prepack": "npm run build --workspace=packages/core"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
